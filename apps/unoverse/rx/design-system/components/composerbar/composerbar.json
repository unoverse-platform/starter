{
  "unoverse": "1.0",
  "kind": "component",
  "name": "ComposerBar",
  "category": "Input",
  "nodeSize": {
    "width": 640,
    "height": 96
  },
  "description": "The message composer: a rounded input pill with a leading chat glyph, a microphone, and a circular send button. Sits at the foot of a chat surface. Owns its full style — references semantic tokens only, so it themes per org.",
  "whenToUse": "The always-present text-entry bar at the bottom of a conversational app. Composed into a chat template as fixed chrome; binds its draft to the template's input field.",
  "root": {
    "type": "Box",
    "style": {
      "direction": "row",
      "gap": "sm",
      "padding": [
        "4",
        "8",
        "6",
        "8"
      ],
      "background": "transparent",
      "when": [
        {
          "field": "hasMessages",
          "eq": true,
          "apply": {
            "background": "surface.base"
          }
        }
      ]
    },
    "children": [
      {
        "type": "Box",
        "style": {
          "flex": 1,
          "direction": "row",
          "align": "center",
          "gap": "sm",
          "background": "surface.raised",
          "border": "none",
          "radius": "full",
          "shadow": "md",
          "padding": [
            "3",
            "4"
          ]
        },
        "children": [
          {
            "type": "Icon",
            "icon": "chat",
            "style": {
              "width": "5",
              "height": "5",
              "color": "text.tertiary"
            }
          },
          {
            "type": "Input",
            "placeholder": "Ask me anything…",
            "action": "sendMessage",
            "bind": {
              "value": "draft"
            },
            "style": {
              "flex": 1,
              "font": "body.md",
              "color": "text.primary",
              "background": "transparent",
              "border": "none",
              "outline": "none"
            }
          },
          {
            "type": "Icon",
            "icon": "mic",
            "style": {
              "width": "5",
              "height": "5",
              "color": "text.tertiary"
            }
          },
          {
            "type": "Button",
            "action": "sendMessage",
            "style": {
              "width": "10",
              "height": "10",
              "align": "center",
              "justify": "center",
              "radius": "full",
              "background": "action.primary",
              "border": "none",
              "cursor": "pointer",
              "padding": "0",
              "flex": "0 0 auto",
              "transition": "all 150ms ease",
              "hover": {
                "background": "action.primary-hover"
              },
              "direction": "row"
            },
            "children": [
              {
                "type": "Icon",
                "icon": "send",
                "style": {
                  "width": "5",
                  "height": "5",
                  "color": "action.primary-text"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
