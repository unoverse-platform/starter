{
  "unoverse": "1.0",
  "kind": "atom",
  "name": "EmptyState",
  "description": "A centered nothing-here block: a muted icon over a title and a hint line. Owns its full style — references tokens only.",
  "whenToUse": "The empty condition of a list, search, or collection — say what is empty and what fills it. Compose via a Ref, mapping icon/title/hint; gate it on the host's empty condition.",
  "props": {
    "icon": {
      "type": "string",
      "default": "search"
    },
    "title": {
      "type": "string",
      "default": "Nothing here yet"
    },
    "hint": {
      "type": "string",
      "default": ""
    }
  },
  "root": {
    "type": "Box",
    "style": {
      "direction": "column",
      "align": "center",
      "justify": "center",
      "gap": "2",
      "width": "full",
      "padding": "10"
    },
    "children": [
      {
        "type": "Icon",
        "bind": {
          "name": "icon"
        },
        "style": {
          "width": "8",
          "height": "8",
          "color": "text.tertiary"
        }
      },
      {
        "type": "Text",
        "bind": {
          "value": "title"
        },
        "style": {
          "font": "body.md",
          "weight": "semibold",
          "color": "text.secondary"
        }
      },
      {
        "type": "Text",
        "visibleWhen": "hint",
        "bind": {
          "value": "hint"
        },
        "style": {
          "font": "body.sm",
          "color": "text.tertiary"
        }
      }
    ]
  }
}
