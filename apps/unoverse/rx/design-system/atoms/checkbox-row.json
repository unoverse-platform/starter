{
  "unoverse": "1.0",
  "kind": "atom",
  "name": "CheckboxRow",
  "description": "A selectable row with a real checkbox: a bordered square that fills with the brand color and a check glyph when the bound `checked` field is true, beside a label and optional description. Owns its full style — references tokens only.",
  "whenToUse": "A multi-select option or a confirm/agree row, wherever the checked state must stay visible. Compose via a Ref, mapping label/description and binding checked to the host field its action toggles; the host supplies the action.",
  "props": {
    "label": {
      "type": "string",
      "default": "Option"
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "checked": {
      "type": "boolean",
      "default": false
    }
  },
  "root": {
    "type": "Button",
    "action": "toggle",
    "style": {
      "width": "full",
      "direction": "row",
      "align": "center",
      "gap": "3",
      "padding": "3",
      "textAlign": "start",
      "background": "surface.base",
      "border": "subtle",
      "radius": "lg",
      "cursor": "pointer",
      "transition": "all 150ms ease",
      "hover": {
        "background": "surface.sunken"
      }
    },
    "children": [
      {
        "type": "Box",
        "style": {
          "flex": "0 0 auto",
          "width": "5",
          "height": "5",
          "radius": "sm",
          "border": "subtle",
          "background": "surface.base",
          "direction": "row",
          "align": "center",
          "justify": "center",
          "transition": "all 150ms ease",
          "when": [
            {
              "field": "checked",
              "eq": true,
              "apply": {
                "background": "action.primary"
              }
            }
          ]
        },
        "children": [
          {
            "type": "Icon",
            "icon": "check",
            "visibleWhen": {
              "field": "checked",
              "eq": true
            },
            "style": {
              "width": "3",
              "height": "3",
              "color": "action.primary-text"
            }
          }
        ]
      },
      {
        "type": "Box",
        "style": {
          "direction": "column",
          "flex": "1",
          "minWidth": "0",
          "gap": "1",
          "align": "start"
        },
        "children": [
          {
            "type": "Text",
            "bind": {
              "value": "label"
            },
            "style": {
              "font": "body.md",
              "weight": "semibold",
              "color": "text.primary"
            }
          },
          {
            "type": "Text",
            "visibleWhen": "description",
            "bind": {
              "value": "description"
            },
            "style": {
              "font": "body.sm",
              "color": "text.secondary"
            }
          }
        ]
      }
    ]
  }
}
