{
  "unoverse": "1.0",
  "kind": "atom",
  "name": "Alert",
  "description": "An inline status message: an icon beside a title with an optional body line, on a soft bordered surface. Neutral by default; override background/border via the Ref's style with the status tones (status.success-subtle / success-border, warning, error) for a colored alert. Owns its full style — references tokens only.",
  "whenToUse": "A confirmation, warning, or error the user should read in place (form feedback, action results, notices). Compose via a Ref, mapping title/body to host fields and setting the tone with a style override.",
  "props": {
    "icon": {
      "type": "string",
      "default": "info"
    },
    "title": {
      "type": "string",
      "default": "Something to know"
    },
    "body": {
      "type": "string",
      "default": ""
    }
  },
  "root": {
    "type": "Box",
    "style": {
      "direction": "row",
      "align": "start",
      "gap": "3",
      "width": "full",
      "padding": "4",
      "background": "surface.sunken",
      "border": "subtle",
      "radius": "sm"
    },
    "children": [
      {
        "type": "Icon",
        "bind": {
          "name": "icon"
        },
        "style": {
          "flex": "0 0 auto",
          "width": "5",
          "height": "5",
          "color": "text.secondary"
        }
      },
      {
        "type": "Box",
        "style": {
          "direction": "column",
          "gap": "1"
        },
        "children": [
          {
            "type": "Text",
            "bind": {
              "value": "title"
            },
            "style": {
              "font": "body.md",
              "weight": "semibold",
              "color": "text.primary"
            }
          },
          {
            "type": "Text",
            "visibleWhen": "body",
            "bind": {
              "value": "body"
            },
            "style": {
              "font": "body.sm",
              "color": "text.secondary"
            }
          }
        ]
      }
    ]
  }
}
