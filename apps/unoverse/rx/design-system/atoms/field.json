{
  "unoverse": "1.0",
  "kind": "atom",
  "name": "Field",
  "description": "A labeled text input: a small label above an Input, with an optional help line beneath. The standard form row. Owns its full style — references tokens only.",
  "whenToUse": "Any single-line text entry in a form or wizard step. Compose via a Ref, mapping label/placeholder/help and binding value to the host field the input writes.",
  "props": {
    "label": {
      "type": "string",
      "default": "Label"
    },
    "placeholder": {
      "type": "string",
      "default": ""
    },
    "value": {
      "type": "string",
      "default": ""
    },
    "help": {
      "type": "string",
      "default": ""
    }
  },
  "root": {
    "type": "Box",
    "style": {
      "direction": "column",
      "gap": "1.5",
      "width": "full"
    },
    "children": [
      {
        "type": "Text",
        "bind": {
          "value": "label"
        },
        "style": {
          "font": "label",
          "weight": "medium",
          "color": "text.secondary"
        }
      },
      {
        "type": "Input",
        "placeholder": "{{placeholder}}",
        "bind": {
          "value": "value"
        },
        "style": {
          "width": "full",
          "font": "body.md",
          "color": "text.primary",
          "background": "surface.base",
          "border": "subtle",
          "radius": "sm",
          "padding": [
            "2",
            "3"
          ],
          "minHeight": "10"
        }
      },
      {
        "type": "Text",
        "visibleWhen": "help",
        "bind": {
          "value": "help"
        },
        "style": {
          "font": "caption",
          "color": "text.tertiary"
        }
      }
    ]
  }
}
